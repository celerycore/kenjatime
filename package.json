{
  "name": "kenjatime-core",
  "version": "0.5.8-core-preview",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:core",
    "build": "npm run build:core",
    "test": "npm run test:core && npm run test:core:compiled",
    "compatibility": "npm run test:core && npm run verify:core:interactions && npm run verify:core:movesets",
    "test:characters": "python -m unittest discover -s test -p character_verification_test.py",
    "verify:characters": "python scripts/verify-characters.py",
    "inventory:characters": "node scripts/character-inventory.mjs",
    "benchmark:browser": "python scripts/benchmark-browser.py",
    "android:sync": "npm run android:core:copy",
    "android:open": "cap open android",
    "android:debug": "npm run android:core:debug",
    "android:release": "npm run android:core:copy && cd android && ./gradlew -PkenjatimeCorePreview=true bundleRelease",
    "dev:core": "vite --config vite.core.config.js --host 0.0.0.0",
    "build:core": "vite build --config vite.core.config.js && node scripts/core/audit-build.mjs",
    "test:core": "node --test --experimental-test-isolation=none test/core/*.test.js",
    "benchmark:core": "node scripts/core/benchmark-expressions.mjs",
    "test:core:compiled": "node --import ./test/core/compiled-compat-setup.js --test --experimental-test-isolation=none test/*.test.js",
    "verify:core:interactions": "python scripts/core/compare-native.py",
    "diagnose:core:movesets": "python scripts/core/compare-native.py --group kfm-classic --allow-gaps",
    "verify:core:browser": "python scripts/core/verify-browser.py",
    "verify:core:archives": "python scripts/core/verify-archives.py",
    "verify:core:stages": "python scripts/core/verify-stages.py",
    "verify:core:media": "python scripts/core/verify-media.py",
    "android:core:copy": "npm run build:core && node scripts/core/copy-android.mjs",
    "android:core:debug": "npm run android:core:copy && cd android && ./gradlew -PkenjatimeCorePreview=true assembleDebug",
    "compatibility:legacy": "node scripts/compatibility-audit.mjs",
    "build:reference": "vite build",
    "dev:reference": "vite --host 0.0.0.0",
    "verify:core:movesets": "python scripts/core/compare-native.py --group kfm-classic --require-verified",
    "benchmark:core:combat": "node scripts/core/benchmark-combat.mjs",
    "benchmark:core:animation": "node scripts/core/benchmark-animation.mjs",
    "benchmark:core:rare-akuma": "node scripts/core/verify-rare-akuma-coverage.mjs",
    "verify:core:rare-akuma-health": "node scripts/core/verify-rare-akuma.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@zip.js/zip.js": "2.24.0",
    "7z-wasm": "1.2.0",
    "chiptune3": "0.8.10",
    "fflate": "0.8.2",
    "fzstd": "0.1.1",
    "libarchive-wasm": "1.2.0",
    "lzma": "2.3.2",
    "node-unrar-js": "2.0.2",
    "pixi.js": "8.22.0",
    "three": "0.187.0",
    "vite": "6.4.1",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
