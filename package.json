{
  "name": "mugen-web-lab",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test --experimental-test-isolation=none test/*.test.js",
    "compatibility": "node scripts/compatibility-audit.mjs",
    "test:characters": "python -m unittest discover -s test -p character_verification_test.py",
    "verify:characters": "python scripts/verify-characters.py",
    "inventory:characters": "node scripts/character-inventory.mjs",
    "benchmark:browser": "python scripts/benchmark-browser.py",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "fflate": "0.8.2",
    "fzstd": "0.1.1",
    "libarchive-wasm": "1.2.0",
    "lzma": "2.3.2",
    "node-unrar-js": "2.0.2",
    "pixi.js": "8.22.0",
    "three": "0.187.0",
    "vite": "6.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
